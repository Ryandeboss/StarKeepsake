{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starkeepsake.local/contracts/design-spec/v1.1",
  "title": "StarKeepsake DesignSpec v1.1",
  "description": "Canonical physical design model for an 11 by 14 inch StarKeepsake artwork.",
  "type": "object",
  "required": ["schemaVersion", "designId", "templateId", "physicalArtwork", "regions", "moment", "photo", "customText", "materialStyle", "skySettings", "stars"],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "designId": { "type": "string", "description": "Placeholder is allowed until persistence exists." },
    "templateId": { "type": "string" },
    "physicalArtwork": {
      "type": "object",
      "required": ["widthMm", "heightMm", "units", "origin"],
      "properties": {
        "widthMm": { "const": 279.4 },
        "heightMm": { "const": 355.6 },
        "units": { "const": "mm" },
        "origin": { "const": "top-left" }
      },
      "additionalProperties": false
    },
    "regions": {
      "type": "object",
      "required": ["sky", "engravingPhoto", "text"],
      "properties": {
        "sky": { "$ref": "#/$defs/region" },
        "engravingPhoto": { "$ref": "#/$defs/region" },
        "text": { "$ref": "#/$defs/region" }
      },
      "additionalProperties": false
    },
    "moment": {
      "type": "object",
      "required": ["date", "time", "exactTimeUnknown", "location", "localDateTime", "utcDateTime"],
      "properties": {
        "date": { "type": "string" },
        "time": { "type": ["string", "null"] },
        "exactTimeUnknown": { "type": "boolean" },
        "location": {
          "anyOf": [
            { "$ref": "#/$defs/resolvedLocation" },
            { "type": "null" }
          ]
        },
        "localDateTime": { "type": ["string", "null"] },
        "utcDateTime": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "photo": {
      "type": "object",
      "required": ["assetId", "crop", "positionMm"],
      "properties": {
        "assetId": { "type": "string" },
        "crop": { "$ref": "#/$defs/crop" },
        "positionMm": { "$ref": "#/$defs/rect" }
      },
      "additionalProperties": false
    },
    "customText": {
      "type": "object",
      "required": ["value", "positionMm", "align"],
      "properties": {
        "value": { "type": "string" },
        "positionMm": { "$ref": "#/$defs/rect" },
        "align": { "enum": ["left", "center", "right"] }
      },
      "additionalProperties": false
    },
    "materialStyle": {
      "type": "object",
      "required": ["material", "style"],
      "properties": {
        "material": { "enum": ["midnight", "walnut", "brass"] },
        "style": { "enum": ["Midnight frame", "Warm walnut", "Brushed brass"] }
      },
      "additionalProperties": false
    },
    "skySettings": {
      "type": "object",
      "required": ["background", "brightness", "showConstellation"],
      "properties": {
        "background": { "const": "deep-space" },
        "brightness": { "type": "number", "minimum": 0, "maximum": 1 },
        "showConstellation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "stars": {
      "type": "array",
      "items": { "$ref": "#/$defs/star" }
    }
  },
  "$defs": {
    "resolvedLocation": {
      "type": "object",
      "required": ["query", "displayName", "formattedAddress", "latitude", "longitude", "timeZoneId", "confidence"],
      "properties": {
        "query": { "type": "string" },
        "displayName": { "type": "string" },
        "formattedAddress": { "type": "string" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "timeZoneId": { "type": "string" },
        "confidence": { "enum": ["High", "Medium", "Low", "Unknown"] }
      },
      "additionalProperties": false
    },
    "rect": {
      "type": "object",
      "required": ["xMm", "yMm", "widthMm", "heightMm"],
      "properties": {
        "xMm": { "type": "number", "minimum": 0 },
        "yMm": { "type": "number", "minimum": 0 },
        "widthMm": { "type": "number", "exclusiveMinimum": 0 },
        "heightMm": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "required": ["xMm", "yMm", "widthMm", "heightMm", "label"],
      "properties": {
        "xMm": { "type": "number", "minimum": 0 },
        "yMm": { "type": "number", "minimum": 0 },
        "widthMm": { "type": "number", "exclusiveMinimum": 0 },
        "heightMm": { "type": "number", "exclusiveMinimum": 0 },
        "label": { "type": "string" }
      },
      "additionalProperties": false
    },
    "crop": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "star": {
      "type": "object",
      "required": ["xMm", "yMm", "magnitude", "holeSizeMm", "ledIndex"],
      "properties": {
        "xMm": { "type": "number", "minimum": 0, "maximum": 279.4 },
        "yMm": { "type": "number", "minimum": 0, "maximum": 355.6 },
        "magnitude": { "type": "number" },
        "holeSizeMm": { "type": "number", "exclusiveMinimum": 0 },
        "ledIndex": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
